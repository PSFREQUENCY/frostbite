{
  "name": "@frostbite/telemetry",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/analytics/index.ts",
    "./analytics/browser": "./src/analytics/browser.ts",
    "./errors": "./src/errors/index.ts",
    "./errors/browser": "./src/errors/browser.ts",
    "./errors/server": "./src/errors/server.ts",
    "./scrubber": "./src/scrubber.ts",
    "./settings": "./src/settings.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "env:check": "node --experimental-strip-types ../config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "posthog-js": "1.448.0",
    "posthog-node": "5.73.0",
    "zod": "^4.5.4"
  }
}
